<Window x:Class="MediaHub.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MediaHub" Height="780" Width="1280" MinWidth="1050" MinHeight="620"
        Background="#121212" Foreground="White">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- ЛІВА КАРТКА: плейлисти -->
        <Border Grid.Row="0" Grid.Column="0" Margin="4" Padding="14"
                Background="{StaticResource PanelBrush}" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="MediaHub" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" Margin="0,0,0,14"/>

                <TextBlock Grid.Row="1" Text="Плейлисти" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>

                <ListBox Grid.Row="2" ItemsSource="{Binding Playlists}"
                         SelectedItem="{Binding SelectedPlaylist}"
                         DisplayMemberPath="Name"/>

                <StackPanel Grid.Row="3" Margin="0,10,0,0">
                    <Button Content="Показати всі файли" Margin="0,0,0,12"
                            HorizontalAlignment="Stretch" Click="ShowAllButton_Click"/>
                    <TextBox Margin="0,0,0,6"
                             Text="{Binding NewPlaylistName, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="Створити плейлист" Margin="0,0,0,6"
                            HorizontalAlignment="Stretch" Click="CreatePlaylistButton_Click"/>
                    <Button Content="Видалити плейлист" Margin="0"
                            HorizontalAlignment="Stretch" Click="DeletePlaylistButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ЦЕНТРАЛЬНА КАРТКА: бібліотека -->
        <Border Grid.Row="0" Grid.Column="1" Margin="4" Padding="14"
                Background="{StaticResource PanelBrush}" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Додати папку і пошук -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="+ Додати папку" Style="{StaticResource AccentButton}"
                            Click="ScanButton_Click"/>
                    <TextBlock Text="Пошук:" VerticalAlignment="Center" Margin="16,0,8,0"
                               Foreground="{StaticResource MutedBrush}"/>
                    <TextBox Width="260" VerticalContentAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- Фільтри -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Жанр:" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{StaticResource MutedBrush}"/>
                    <ComboBox Width="140" ItemsSource="{Binding Genres}"
                              SelectedItem="{Binding SelectedGenre}"/>
                    <TextBlock Text="Виконавець:" VerticalAlignment="Center" Margin="16,0,6,0"
                               Foreground="{StaticResource MutedBrush}"/>
                    <ComboBox Width="170" ItemsSource="{Binding Artists}"
                              SelectedItem="{Binding SelectedArtist}"/>
                    <TextBlock Text="Альбом:" VerticalAlignment="Center" Margin="16,0,6,0"
                               Foreground="{StaticResource MutedBrush}"/>
                    <ComboBox Width="170" ItemsSource="{Binding Albums}"
                              SelectedItem="{Binding SelectedAlbum}"/>
                </StackPanel>

                <!-- Дії з вибраним файлом -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="В плейлист..." Click="AddToPlaylistButton_Click"/>
                    <Button Content="Прибрати з плейлиста" Click="RemoveFromPlaylistButton_Click"/>
                    <Button Content="Видалити з бібліотеки" Click="DeleteFileButton_Click"/>
                </StackPanel>

                
                                <!-- Таблиця -->
                <DataGrid Grid.Row="3"
                          ItemsSource="{Binding Files}"
                          SelectedItem="{Binding SelectedFile}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          MouseDoubleClick="Grid_MouseDoubleClick">
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#2A2A2A"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Назва" Binding="{Binding Title}" Width="2*"/>
                        <DataGridTextColumn Header="Виконавець" Binding="{Binding Artist}" Width="*"/>
                        <DataGridTextColumn Header="Альбом" Binding="{Binding Album}" Width="*"/>
                        <DataGridTextColumn Header="Жанр" Binding="{Binding Genre}" Width="*"/>
                        <DataGridTextColumn Header="Тип" Binding="{Binding Type, Mode=OneWay}" Width="70"/>
                        <DataGridTextColumn Header="Тривалість"
                                            Binding="{Binding Duration, StringFormat={}{0:h\\:mm\\:ss}}"
                                            Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ПРАВА КАРТКА: зараз грає -->
        <Border Grid.Row="0" Grid.Column="2" Margin="4" Padding="16"
                Background="{StaticResource PanelBrush}" CornerRadius="8">
            <StackPanel>
                <TextBlock Text="Зараз грає" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"/>

                <!-- Три шари в одній клітинці: заглушка, обкладинка, відео -->
                <Grid Width="266" Height="266" ClipToBounds="True">
                    <Border Background="#2A2A2A" CornerRadius="8">
                        <TextBlock Text="♪" FontSize="96" Opacity="0.35"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Image x:Name="CoverImage" Stretch="UniformToFill"/>
                    <MediaElement x:Name="Player" Stretch="Uniform"
                                  MediaOpened="Player_MediaOpened"
                                  MediaEnded="Player_MediaEnded"
                                  MediaFailed="Player_MediaFailed"/>
                </Grid>

                <TextBlock x:Name="NowTitle" Text="Нічого не грає" FontSize="20" FontWeight="Bold"
                           TextWrapping="Wrap" Margin="0,16,0,4"/>
                <TextBlock x:Name="NowArtist" Text="Двічі клікніть по треку в таблиці"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- НИЖНЯ СМУГА: керування відтворенням -->
        <Border Grid.Row="1" Grid.ColumnSpan="3" Margin="4" Padding="16,12"
                Background="{StaticResource PanelBrush}" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="▶ Грати" Style="{StaticResource AccentButton}"
                            Click="PlayButton_Click"/>
                    <Button Content="Пауза" Click="PauseButton_Click"/>
                    <Button Content="Стоп" Click="StopButton_Click"/>
                </StackPanel>

                <ProgressBar x:Name="PlayProgress" Grid.Column="1" Height="6" Margin="20,0"
                             VerticalAlignment="Center"
                             Foreground="{StaticResource AccentBrush}"/>

                <TextBlock x:Name="TimeText" Grid.Column="2" Text="0:00:00 / 0:00:00"
                           VerticalAlignment="Center" Margin="0,0,24,0"
                           Foreground="{StaticResource MutedBrush}"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <TextBlock Text="Гучність:" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{StaticResource MutedBrush}"/>
                    <Slider x:Name="VolumeSlider" Width="120" Minimum="0" Maximum="1" Value="0.5"
                            VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Статус -->
        <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding Status}"
                   Foreground="{StaticResource MutedBrush}" Margin="8,4,0,0"/>
    </Grid>
</Window>