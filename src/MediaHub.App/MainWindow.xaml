<Window x:Class="MediaHub.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MediaHub" Height="750" Width="1000">
    <DockPanel Margin="10">

        <!-- Верхня панель: кнопка та пошук -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Додати папку" Padding="12,4" Click="ScanButton_Click"/>
            <Button Content="В плейлист..." Padding=" 12,4" Margin="5,0,0,0"
                Click="AddToPlaylistButton_Click"/> 
            <Button Content="Прибрати з плейлиста" Padding="12,4" Margin="5,0,0,0"
                    Click="RemoveFromPlaylistButton_Click"/>
            <TextBlock Text="Пошук:" VerticalAlignment="Center" Margin="20,0,5,0"/>
            <TextBox Width="200"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <!-- Нижні панелі (від найнижчої до вищої) -->
        
        <!-- Фільтри -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Жанр:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox Width="150" ItemsSource="{Binding Genres}"
                      SelectedItem="{Binding SelectedGenre}"/>
            <TextBlock Text="Виконавець:" VerticalAlignment="Center" Margin="20,0,5,0"/>
            <ComboBox Width="180" ItemsSource="{Binding Artists}"
                      SelectedItem="{Binding SelectedArtist}"/>
            <TextBlock Text="Альбом:" VerticalAlignment="Center" Margin="20,0,5,0"/>
            <ComboBox Width="180" ItemsSource="{Binding Albums}"
                      SelectedItem="{Binding SelectedAlbum}"/>
        </StackPanel>
        
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Margin="0,10,0,0"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Грати" Padding="12,4" Click="PlayButton_Click"/>
            <Button Content="Пауза" Padding="12,4" Margin="5,0,0,0" Click="PauseButton_Click"/>
            <Button Content="Стоп" Padding="12,4" Margin="5,0,0,0" Click="StopButton_Click"/>
            <TextBlock Text="Гучність:" VerticalAlignment="Center" Margin="20,0,5,0"/>
            <Slider x:Name="VolumeSlider" Width="100" Minimum="0" Maximum="1" Value="0.5"
                    VerticalAlignment="Center"/>
            <TextBlock x:Name="TimeText" Text="0:00:00 / 0:00:00"
                       VerticalAlignment="Center" Margin="20,0,0,0"/>
        </StackPanel>

        <ProgressBar x:Name="PlayProgress" DockPanel.Dock="Bottom" Height="10" Margin="0,10,0,0"/>

        <MediaElement x:Name="Player" DockPanel.Dock="Bottom" Height="200" Margin="0,10,0,0"
                      MediaOpened="Player_MediaOpened"
                      MediaEnded="Player_MediaEnded"
                      MediaFailed="Player_MediaFailed"/>

        <!-- Ліва панель: плейлисти -->
        <StackPanel DockPanel.Dock="Left" Width="190" Margin="0,0,10,0">
            <TextBlock Text="Плейлисти" FontWeight="Bold" Margin="0,0,0,5"/>
            <ListBox ItemsSource="{Binding Playlists}"
                     SelectedItem="{Binding SelectedPlaylist}"
                     DisplayMemberPath="Name"
                     Height="280"/>
            <Button Content="Показати всі файли" Margin="0,5,0,0" Padding="0,4"
                    Click="ShowAllButton_Click"/>
            <TextBox Margin="0,15,0,0"
                     Text="{Binding NewPlaylistName, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="Створити плейлист" Margin="0,5,0,0" Padding="0,4"
                    Click="CreatePlaylistButton_Click"/>
            <Button Content="Видалити плейлист" Margin="0,15,0,0" Padding="0,4"
                    Click="DeletePlaylistButton_Click"/>
        </StackPanel>
        
        <!-- Таблиця медіатеки -->
        <DataGrid ItemsSource="{Binding Files}"
                  SelectedItem="{Binding SelectedFile}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  MouseDoubleClick="Grid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Назва" Binding="{Binding Title}" Width="2*"/>
                <DataGridTextColumn Header="Виконавець" Binding="{Binding Artist}" Width="*"/>
                <DataGridTextColumn Header="Альбом" Binding="{Binding Album}" Width="*"/>
                <DataGridTextColumn Header="Жанр" Binding="{Binding Genre}" Width="*"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding Type, Mode=OneWay}" Width="70"/>
                <DataGridTextColumn Header="Тривалість"
                                    Binding="{Binding Duration, StringFormat={}{0:h\:mm\:ss}}"
                                    Width="90"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>